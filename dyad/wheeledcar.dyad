"short Car component description"
component WheeledCar
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  engine = MyCar.Engine() {^engine}
  body = MyCar.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed1 = TranslationalComponents.Components.Fixed() {^fixed1}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  gain = BlockComponents.Math.Gain(k = 3.6) {^gain}
  v_kmh = Dyad.RealOutput() {^v_kmh}
  driveline = MyCar.WheeledDriveline() {^driveline}
relations
  connect(tau_cmd, engine.tau_cmd) {^id10}
  connect(engine.support, fixed.spline, driveline.support_r) {^id11}
  connect(vsensor.flange, body.flange, driveline.flange) {^id12}
  connect(vsensor.v, gain.u) {^id13}
  connect(v_kmh, gain.y) {^id14}
  connect(engine.spline, driveline.spline) {^id15}
  connect(driveline.support_t, fixed1.flange) {^id16}
