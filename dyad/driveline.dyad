test component TestDriveline
  "Constant engine-side torque"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 100) {^torque}
  driveline = Driveline() {^driveline}
  housing = RotationalComponents.Components.Fixed() {^housing}
  mass = TranslationalComponents.Components.Mass(m = 1400) {^mass}
  road = TranslationalComponents.Components.Fixed() {^road}
relations
  connect(torque.spline, driveline.spline) {^id6}
  connect(torque.support, housing.spline) {^id7}
  connect(driveline.support_r, housing.spline) {^id8}
  connect(driveline.flange, mass.flange_a) {^id9}
  connect(driveline.support_t, road.flange) {^id10}
  initial mass.s = 0
  initial mass.v = 0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {"mass.a": 0.0001, "mass.v": 0.001},
        "expect": {
          "initial": {"mass.a": 0.9216589862, "mass.v": 0},
          "final": {"mass.a": 0.9216589862, "mass.v": 9.216589862},
          "signals": ["mass.v"]
        }
      }
    }
  },
  "_links": {
    "torque": {
      "Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550}}}
    },
    "driveline": {
