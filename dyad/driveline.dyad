"short Driveline component description"
component Driveline
  spline = Dyad.Spline() {^spline}
  support_r = Dyad.Spline() {^support_r}
  flange = Dyad.Flange() {^flange}
  support_t = Dyad.Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear() {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel() {^wheel}
  "Gear ratio"
  parameter i::Real() = 4
  "Wheel rolling radius"
  parameter r::Length() = 0.31
relations
  connect(spline, gear.spline_a) {^id7}
  connect(gear.spline_b, wheel.spline) {^id8}
  connect(wheel.support_r, support_r) {^id9}
  connect(wheel.support_t, support_t) {^id10}
  connect(wheel.flange, flange) {^id11}
  connect(gear.support, support_r) {^id12}
