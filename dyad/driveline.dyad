"short Driveline component description"
component Driveline
  "From the engine"
  spline = Spline() {^spline}
  "Gearbox housing"
  support_r = Spline() {^support_r}
  "To the body"
  flange = Flange() {^flange}
  "Road"
  support_t = Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  "Gear ratio"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
relations
  connect(spline, gear.spline_a) {^id7}
  connect(gear.spline_b, wheel.spline) {^id8}
  connect(wheel.flange, flange) {^id9}
  connect(gear.support, support_r) {^id10}
  connect(wheel.support_r, support_r) {^id11}
  connect(wheel.support_t, support_t) {^id12}
metadata {
  "_links": {
    "spline": {
      "Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}
    },
    "support_r": {
      "Dyad": {"placement": {"diagram": {"x1": 330, "x2": 430, "y1": 950, "y2": 1050}}}
    },
    "flange": {
      "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
    },
    "support_t": {
      "Dyad": {"placement": {"diagram": {"x1": 560, "x2": 660, "y1": 950, "y2": 1050}}}
    },
    "gear": {
      "Dyad": {"placement": {"diagram": {"x1": 330, "x2": 430, "y1": 450, "y2": 550}}}
    },
    "wheel": {
      "Dyad": {"placement": {"diagram": {"x1": 520, "x2": 620, "y1": 450, "y2": 550}}}
    },
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
