"short ABSStopWheelOnlyTransient analysis description"
analysis ABSStopWheelOnlyTransient
  extends Dyad.TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 8
  model = MyCar.ABSStopWheelOnly(road_mu = road_mu, a_ref = a_ref)
relations
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  }
}
end