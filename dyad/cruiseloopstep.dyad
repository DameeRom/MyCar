"short CruiseLoopStep component description"
component CruiseLoopStep
  demand = BlockComponents.Sources.Step(offset = 90, height = 20, start_time = 0) {^demand}
  controller = MyCar.CruiseController(y_max = 150, y_min = 0) {^controller}
  plant = MyCar.GradeCar() {^plant}
  road = BlockComponents.Sources.Constant(k = 0) {^road}
relations
  connect(controller.y, plant.tau_cmd) {^id5}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 25
  initial plant.engine.lag.x = 31.078
  connect(plant.v_kmh, controller.u_m) {^id6}
  connect(plant.grade, road.y) {^id7}
  connect(demand.y, controller.u_s) {^id8}
metadata {
