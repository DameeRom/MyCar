        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
