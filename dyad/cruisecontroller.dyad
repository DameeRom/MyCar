"short CruiseController component description"
component CruiseController
  error = BlockComponents.Math.Add(k2 = -1) {^error}
  u_s = Dyad.RealInput() {^u_s}
  u_m = Dyad.RealInput() {^u_m}
  y = Dyad.RealOutput() {^y}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  "proportional gain"
  parameter k::Real() = 56
relations
  connect(u_s, error.u1) {^id6}
  connect(u_m, error.u2) {^id7}
  connect(gain.y, y) {^id8}
  connect(gain.u, error.y) {^id9}
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "error": {
      "Dyad": {"placement": {"diagram": {"x1": 260, "x2": 360, "y1": 340, "y2": 440}}}
    },
    "u_s": {
