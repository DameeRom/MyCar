"short MapEngineDyno component description"
component MapEngineDyno
  pedal = BlockComponents.Sources.Step(height = pedal_final - pedal_initial, offset = pedal_initial, start_time = t_step) {^pedal}
  no_booster = BlockComponents.Sources.Constant(k = 0) {^no_booster}
  engine = MapEngine() {^engine}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
  dyno = RotationalComponents.Sources.VelocitySource() {^dyno}
  speed = BlockComponents.Sources.Ramp(offset = rpm * pi / 30, height = (800 - rpm) * pi / 30, start_time = 2, duration = 3)
  "Held engine speed [rpm]"
  parameter rpm::Real = 3080.0
  "Pedal before the step"
  parameter pedal_initial::Real = 0.1034
  "Pedal after the step"
  parameter pedal_final::Real = 0.12
  "Pedal step time"
  parameter t_step::Time = 1.0
  "Initial manifold pressure"
  parameter p_m0::Pressure = 47829.1
relations
  connect(pedal.y, engine.pedal) {^id7}
  connect(no_booster.y, engine.mdot_bst) {^id8}
  connect(speed.y, dyno.w_ref) {^id9}
  connect(engine.spline, dyno.spline) {^id10}
  connect(engine.support, mounts.spline) {^id11}
  connect(dyno.support, mounts.spline) {^id12}
  initial dyno.phi = 0
  initial engine.air.manifold.p = p_m0
metadata {
