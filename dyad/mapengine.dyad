"short MapEngine component description"
component MapEngine
  pedal = RealInput() {^pedal}
  mdot_bst = RealInput() {^mdot_bst}
  spline = Spline() {^spline}
  support = Spline() {^support}
  p_m = RealOutput() {^p_m}
  mdot_fuel = RealOutput() {^mdot_fuel}
  mdot_co2 = RealOutput() {^mdot_co2}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath() {^air}
  speed = RotationalComponents.Sensors.VelocitySensor() {^speed}
  torque_map = VehicleSystemsComponents.Vehicle.Engine.TorqueMap() {^torque_map}
  fuel_map = VehicleSystemsComponents.Vehicle.Engine.FuelMap() {^fuel_map}
  co2 = BlockComponents.Math.Gain(k = 3.09) {^co2}
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
relations
  connect(pedal, air.u_thr) {^id14}
  connect(mdot_bst, air.mdot_bst) {^id15}
  connect(speed.w, fuel_map.omega, torque_map.omega) {^id16}
  connect(speed.w, air.omega) {^id17}
  connect(air.p_m, torque_map.p_m) {^id18}
  connect(air.p_m, fuel_map.p_m) {^id19}
  connect(air.p_m, p_m) {^id20}
  connect(torque_map.y, torque.tau) {^id21}
  connect(fuel_map.y, co2.u) {^id22}
  connect(fuel_map.y, mdot_fuel) {^id23}
  connect(co2.y, mdot_co2) {^id24}
  connect(torque.support, support) {^id25}
  connect(torque.spline, spline, speed.spline) {^id26}
