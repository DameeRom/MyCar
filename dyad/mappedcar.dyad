"short Car component description"
component MappedCar
  pedal = RealInput() {^pedal}
  v_kmh = RealOutput() {^v_kmh}
  p_m = RealOutput() {^p_m}
  fuel_lph = RealOutput() {^fuel_lph}
  engine = MapEngine() {^engine}
  "Crankshaft and flywheel, J as MappedEngine assumes"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  no_booster = BlockComponents.Sources.Constant(k = 0) {^no_booster}
  "kg/s of petrol to L/h: 3600 / 0.745"
  to_lph = BlockComponents.Math.Gain(k = 4832.2) {^to_lph}
  driveline = VehicleSystemsComponents.Vehicle.CVTDriveline(ratio_initial = ratio_initial) {^driveline}
  body = Body() {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
  "Initial CVT ratio, engine to wheel"
  parameter ratio_initial::Real = 12
relations
  connect(pedal, engine.pedal) {^id15}
  connect(pedal, driveline.pedal) {^id16}
  connect(no_booster.y, engine.mdot_bst) {^id17}
  connect(engine.spline, flywheel.spline_a) {^id18}
  connect(flywheel.spline_b, driveline.spline)
  connect(engine.support, rot_ground.spline) {^id19}
  connect(driveline.support_r, rot_ground.spline) {^id20}
  connect(driveline.flange, body.flange) {^id21}
  connect(driveline.support_t, trans_ground.flange) {^id22}
  connect(vsensor.flange, body.flange) {^id23}
  connect(vsensor.v, to_kmh.u)
  connect(to_kmh.y, v_kmh)
  connect(engine.p_m, p_m) {^id24}
  connect(engine.mdot_fuel, to_lph.u) {^id25}
  connect(to_lph.y, fuel_lph)
metadata {
