test component TestGradeBody
  "500 N of traction, on the flat or on a climb"
  tractive = TranslationalComponents.Sources.ConstantForce(f_constant = 500) {^tractive}
  road = BlockComponents.Sources.Constant(k = 0) {^road}
  body = GradeBody(mass(s(initial = 0), v(initial = 0))) {^body}
  fixed = TranslationalComponents.Components.Fixed() {^fixed}
relations
  connect(tractive.flange, body.flange) {^id1}
  connect(tractive.support, fixed.flange) {^id2}
  connect(road.y, body.grade) {^id3}
metadata {
  "Dyad": {
    "tests": {
      "flat": {
        "stop": 800,
        "params": {"road.k": 0},
        "initial": {"body.mass.v": 0},
        "atol": {"body.mass.a": 0.001, "body.mass.v": 0.001},
        "expect": {
          "initial": {"body.mass.a": 0.35714285714285715, "body.mass.v": 0},
          "final": {"body.mass.a": 0, "body.mass.v": 29.780869893947216},
          "signals": ["body.mass.v"]
        }
      },
      "climb": {
        "stop": 10,
        "params": {"road.k": 0.02},
        "initial": {"body.mass.v": 10},
        "atol": {"body.mass.a": 0.001, "body.mass.v": 0.001},
        "expect": {
          "initial": {"body.mass.a": 0.0163928, "body.mass.v": 10},
          "final": {"body.mass.v": 10.15956},
          "signals": ["body.mass.v"]
        }
      }
    }
  },
  "_links": {
