"short EngineStep component description"
component EngineStep
  engine = MyCar.engine() {^engine}
  cmd = BlockComponents.Sources.Step(height = 200, start_time = 0.5, offset = 0) {^cmd}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
  load = RotationalComponents.Components.Inertia(J = 1) {^load}
relations
  connect(cmd.y, engine.tau_cmd) {^id5}
  connect(engine.spline, load.spline_a) {^id6}
  connect(engine.support, mounts.spline) {^id7}
  initial engine.lag.x = 0
  initial load.phi = 0
  initial load.w = 0
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "engine": {
      "Dyad": {"placement": {"diagram": {"x1": 340, "x2": 440, "y1": 450, "y2": 550}}}
    },
    "cmd": {
      "Dyad": {"placement": {"diagram": {"x1": 50, "x2": 150, "y1": 450, "y2": 550}}}
    },
    "mounts": {
      "Dyad": {"placement": {"diagram": {"x1": 340, "x2": 440, "y1": 620, "y2": 720}}}
    },
    "load": {
      "Dyad": {"placement": {"diagram": {"x1": 570, "x2": 670, "y1": 450, "y2": 550}}}
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end


