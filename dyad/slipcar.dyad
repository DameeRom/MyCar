"short SlipCar component description"
component SlipCar
  "Commanded engine torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Road-friction multiplier"
  mu_scale = RealInput() {^mu_scale}
  "Vehicle speed in km/h"
  v_kmh = RealOutput() {^v_kmh}
  "Wheel surface speed, omega * radius, in km/h"
  wheel_kmh = RealOutput() {^wheel_kmh}
  engine = Engine(theta_e = theta_e, T_max = T_max) {^engine}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel_inertia = RotationalComponents.Components.Inertia(J = J_w) {^wheel_inertia}
  wheel = SlipWheel1D(radius = r, F_z = m * g / 2) {^wheel}
  body = GradeBody(m = m, CdA = CdA, g = g) {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  wsensor = RotationalComponents.Sensors.VelocitySensor() {^wsensor}
  wheel_to_kmh = BlockComponents.Math.Gain(k = r * 3.6) {^wheel_to_kmh}
  "Engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Injection-to-torque transport delay"
  structural parameter theta_e::Time = 0.3
  "Peak deliverable torque"
  parameter T_max::Torque = 150
  "Gear ratio"
  parameter i::Real = 4.0
  "Road wheel and tire inertia"
  parameter J_w::MomentOfInertia = 1.0
  "Wheel rolling radius, shared by the tire and the wheel-speed gain"
  parameter r::Length = 0.31
  "Vehicle mass; the driven axle carries half of it"
  parameter m::Dyad.Mass = 1400
  "Aerodynamic drag area, Cd * A"
  parameter CdA::Area = 0.63
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
relations
  connect(grade, body.grade) {^id16}
  connect(mu_scale, wheel.mu_scale) {^id17}
  connect(tau_cmd, engine.tau_cmd) {^id18}
  connect(engine.support, rot_ground.spline, gear.support) {^id19}
  connect(engine.spline, gear.spline_a) {^id20}
  connect(gear.spline_b, wheel_inertia.spline_a) {^id21}
  connect(wheel_inertia.spline_b, wheel.spline, wsensor.spline) {^id22}
  connect(wsensor.w, wheel_to_kmh.u) {^id23}
  connect(wheel_to_kmh.y, wheel_kmh) {^id24}
  connect(wheel.flange, body.flange, vsensor.flange) {^id25}
  connect(vsensor.v, to_kmh.u) {^id26}
  connect(to_kmh.y, v_kmh) {^id27}
