"short CruiseLoopStep component description"
component CruiseClimb
  demand = BlockComponents.Sources.Constant(k = 130) {^demand}
  controller = CruiseController(y_max = 150, y_min = 0, xd0 = -130) {^controller}
  plant = GradeCar() {^plant}
  road = BlockComponents.Sources.Pulse(amplitude = 0.10, offset = 0, start_time = 30, duty_cycle = 1.0, period = 120) {^road}
relations
  connect(controller.y, plant.tau_cmd) {^id5}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 36.111111111111114
  initial plant.engine.lag.x = 50.9693
  connect(demand.y, controller.u_s) {^id6}
  connect(plant.v_kmh, controller.u_m) {^id7}
  connect(road.y, plant.grade) {^id8}
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
