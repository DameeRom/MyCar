"short TestTireFrictionCurve component description"
component TestTireFrictionCurve
  "Slip swept from a locked wheel under braking to full wheelspin"
  slip = BlockComponents.Sources.Ramp(offset = -1, height = 2, duration = 2, start_time = 0) {^slip}
  curve = TireFrictionCurve() {^curve}
relations
  connect(slip.y, curve.kappa) {^id3}
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "slip": {
      "Dyad": {"placement": {"diagram": {"x1": 310, "x2": 410, "y1": 450, "y2": 550}}}
    },
    "curve": {
      "Dyad": {"placement": {"diagram": {"x1": 660, "x2": 760, "y1": 450, "y2": 550}}}
    },
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end