"short SlipWheel1D component description"
component SlipWheel1D
  "Wheel shaft"
  spline = Spline() {^spline}
  "Contact with the body"
  flange = Flange() {^flange}
  "Road-friction multiplier"
  mu_scale = RealInput() {^mu_scale}
  curve = TireFrictionCurve(mu_S = 0.2) {^curve}
  "Wheel rolling radius"
  parameter radius::Length = 0.31
  "Normal load on the driven axle"
  parameter F_z::Force = 6864.655
  "Speed below which slip is measured against v_eps instead of v"
  parameter v_eps::Velocity = 0.5
  "Wheel angular speed"
  variable omega::AngularVelocity
  "Vehicle speed"
  variable v::Velocity
  "Longitudinal slip ratio"
  variable kappa::Real
  "Friction coefficient after road scaling"
  variable mu::Real
  "Longitudinal tire force"
  variable F_x::Force
relations
  omega = der(spline.phi)
  v = der(flange.s)
  # At standstill v = 0 and the slip ratio is undefined; the floor keeps it finite.
  kappa = (omega * radius - v) / max(abs(v), v_eps)
  curve.kappa = kappa
  mu = mu_scale * curve.mu
  F_x = mu * F_z
  # Flow is positive into the component: the tire pushes the body forward with F_x, so the
  # flange reports -F_x, and the shaft feels the matching reaction torque.
  flange.f = -F_x
  0 = spline.tau + radius * flange.f
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "spline": {
      "Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}
    },
    "flange": {
      "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
    },
    "mu_scale": {
      "Dyad": {
        "placement": {"diagram": {"x1": 450, "x2": 550, "y1": -40, "y2": 60, "rot": 90}}
      }
    },
    "curve": {
      "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}
    }
  }
}
end

test component TestSlipWheel1D
  "Full engine torque after the 4:1 gear"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 600) {^torque}
  inertia = RotationalComponents.Components.Inertia(J = 1) {^inertia}
  wheel = SlipWheel1D() {^wheel}
  mass = TranslationalComponents.Components.Mass(m = 1400) {^mass}
  mu_src = BlockComponents.Sources.Constant(k = 0.2) {^mu_src}
  fixed_r = RotationalComponents.Components.Fixed() {^fixed_r}
relations
  connect(torque.spline, inertia.spline_a) {^id1}
  connect(torque.support, fixed_r.spline) {^id2}
  connect(inertia.spline_b, wheel.spline) {^id3}
  connect(wheel.flange, mass.flange_a) {^id4}
  connect(mu_src.y, wheel.mu_scale) {^id5}
  initial inertia.phi = 0
  initial inertia.w = 0
  initial mass.s = 0
  initial mass.v = 0
end
