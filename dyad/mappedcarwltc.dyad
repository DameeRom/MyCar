"WLTC class 3b bench: the trace drives the cruise controller, the controller's effort splits into pedal and brake, and the run's fuel and distance are totalled"
component MappedCarWLTC
  "WLTC class 3b target speed [km/h]"
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  "Driver: PID on the speed error, output an effort in [-1, 1]"
  driver = CruiseController(k = k, Ti = Ti, Td = Td, xd0 = 0, xi0 = 0, y_max = 1, y_min = -1) {^driver}
  car = MappedCar() {^car}
  "Positive part of the effort: the pedal"
  pedal_part = BlockComponents.Nonlinear.Limiter(y_min = 0, y_max = 1) {^pedal_part}
  "Negative part of the effort"
  brake_part = BlockComponents.Nonlinear.Limiter(y_min = -1, y_max = 0) {^brake_part}
  "Negative effort to brake force [N]"
  to_force = BlockComponents.Math.Gain(k = -F_brake_max) {^to_force}
  "L/h to liters: 1 / 3600"
  fuel_L = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^fuel_L}
  "km/h to km: 1 / 3600"
  dist_km = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^dist_km}
  "Controller gain, effort per km/h"
  parameter k::Real = 0.14
  "Integral time"
  parameter Ti::Time = 3.5
  "Derivative time"
  parameter Td::Time = 0.7
  "Brake force at an effort of -1"
  parameter F_brake_max::Force = 4000
  
relations
  connect(trace.y, driver.u_s) {^id9}
  connect(car.v_kmh, driver.u_m) {^id10}
  connect(driver.y, pedal_part.u, brake_part.u) {^id11}
  connect(pedal_part.y, car.pedal) {^id12}
  connect(brake_part.y, to_force.u) {^id13}
  connect(to_force.y, car.F_break) {^id14}
  connect(car.fuel_lph, fuel_L.u) {^id15}
  connect(car.v_kmh, dist_km.u) {^id16}
  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.flywheel.w = 775 * pi / 30
  initial car.flywheel.phi = 0
  initial car.driveline.clutch.spline_b.phi = 0
  initial car.engine.air.manifold.p = 33600
