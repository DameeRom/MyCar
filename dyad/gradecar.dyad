"short Car component description"
component GradeCar
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  engine = MyCar.Engine(T_max = T_max) {^engine}
  driveline = MyCar.Driveline() {^driveline}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed1 = TranslationalComponents.Components.Fixed() {^fixed1}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  gain = BlockComponents.Math.Gain(k = 3.6) {^gain}
  v_kmh = Dyad.RealOutput() {^v_kmh}
  body = MyCar.GradeBody() {^body}
  grade = Dyad.RealInput() {^grade}
  parameter T_max::Torque() = 150
relations
  connect(tau_cmd, engine.tau_cmd) {^id11}
  connect(engine.spline, driveline.spline) {^id12}
  connect(driveline.support_t, fixed1.flange) {^id13}
  connect(engine.support, fixed.spline, driveline.support_r) {^id14}
  connect(vsensor.flange, driveline.flange, body.flange) {^id15}
  connect(vsensor.v, gain.u) {^id16}
  connect(v_kmh, gain.y) {^id17}
  connect(body.grade, grade) {^id18}
metadata {
