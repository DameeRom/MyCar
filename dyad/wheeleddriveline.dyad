"short Driveline component description"
component WheeledDriveline
  "From the engine"
  spline = Dyad.Spline() {^spline}
  "Gearbox housing"
  support_r = Dyad.Spline() {^support_r}
  "To the body"
  flange = Dyad.Flange() {^flange}
  "Road"
  support_t = Dyad.Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  inertia = RotationalComponents.Components.Inertia(J = J_w) {^inertia}
  "Gear ratio"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Dyad.Length = 0.31
  "Road wheel and tire inertia"
  parameter J_w::MomentOfInertia() = 1.0
relations
  connect(spline, gear.spline_a) {^id8}
  connect(wheel.flange, flange) {^id9}
  connect(gear.support, support_r) {^id10}
  connect(wheel.support_r, support_r) {^id11}
  connect(wheel.support_t, support_t) {^id12}
  connect(gear.spline_b, inertia.spline_a) {^id13}
  connect(inertia.spline_b, wheel.spline) {^id14}
metadata {
