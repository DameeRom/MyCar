"""
Standing start on snow (mu_scale = 0.2): engine at idle, throttle floored at 0 s. Brake TCS and
engine TCS are switched in by `brake_enabled` and `engine_enabled` (0 off, 1 on), each through its
own Gain. The engine gain acts on the throttle cut, 1 - limit, so 0 means no limit.
"""
component TCSStart
  "1 enables the brake intervention"
  parameter brake_enabled::Real = 1.0
  "1 enables the engine intervention"
  parameter engine_enabled::Real = 1.0
  "Pump and accumulator supply pressure"
  parameter supply_pressure::Pressure = 8.9e6
  "Driver floors the throttle from idle"
  throttle = BlockComponents.Sources.Step(height = 1.0, offset = 0.0, start_time = 0.0) {^throttle}
  "Snow"
  friction = BlockComponents.Sources.Constant(k = 0.2) {^friction}
  supply = BlockComponents.Sources.Constant(k = supply_pressure) {^supply}
  one = BlockComponents.Sources.Constant(k = 1.0) {^one}
  brake_tcs = BrakeTCS() {^brake_tcs}
  brake_gain = BlockComponents.Math.Gain(k = brake_enabled) {^brake_gain}
  engine_tcs = EngineTCS() {^engine_tcs}
  "Throttle cut, 1 - limit"
  engine_cut = BlockComponents.Math.Feedback() {^engine_cut}
  engine_gain = BlockComponents.Math.Gain(k = engine_enabled) {^engine_gain}
  "Applied limit, 1 - gated cut"
  engine_limit = BlockComponents.Math.Feedback() {^engine_limit}
  car = TCSCar(supply_pressure = supply_pressure) {^car}
relations
  connect(throttle.y, car.pedal) {^id12}
  connect(friction.y, car.mu_scale) {^id13}
  connect(car.kappa, brake_tcs.kappa, engine_tcs.kappa) {^id14}
  connect(supply.y, brake_tcs.demand) {^id15}
  connect(brake_tcs.p_cmd, brake_gain.u) {^id16}
  connect(brake_gain.y, car.p_cmd) {^id17}
  connect(one.y, engine_cut.u1, engine_limit.u1) {^id18}
  connect(engine_tcs.u_lim, engine_cut.u2) {^id19}
  connect(engine_cut.y, engine_gain.u) {^id20}
  connect(engine_gain.y, engine_limit.u2) {^id21}
  connect(engine_limit.y, car.u_tcs) {^id22}
  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.wheel.inertia.phi = 0
  initial car.wheel.inertia.w = 0
  "Engine idling at 900 rpm, manifold at its idle vacuum"
  initial car.flywheel.w = 900 * pi / 30
  initial car.flywheel.phi = 0
  initial car.clutch.spline_b.phi = 0
  initial car.engine.air.manifold.p = 33000
metadata {
