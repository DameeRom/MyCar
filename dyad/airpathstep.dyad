"short AirPathStep component description"
component AirPathStep
  manifold = MyCar.Manifold() {^manifold}
  throttle_cmd = BlockComponents.Sources.Step(offset = 0, height = 1, start_time = 1) {^throttle_cmd}
  speed = BlockComponents.Sources.Constant(k = 314.159) {^speed}
  throttle = VehicleSystemsComponents.Vehicle.Engine.Throttle() {^throttle}
  cylinderairflow = VehicleSystemsComponents.Vehicle.Engine.CylinderAirflow() {^cylinderairflow}
  no_booster = BlockComponents.Sources.Constant(k = 0) {^no_booster}
relations
  connect(throttle_cmd.y, throttle.u_thr) {^id7}
  connect(speed.y, cylinderairflow.omega) {^id8}
  connect(no_booster.y, manifold.mdot_bst) {^id9}
  connect(cylinderairflow.mdot_cyl, manifold.mdot_cyl) {^id10}
  connect(throttle.mdot_thr, manifold.mdot_thr) {^id11}
  connect(manifold.p_m, throttle.p_m) {^id12}
  connect(cylinderairflow.p_m, manifold.p_m) {^id13}
  initial manifold.p = 101325
