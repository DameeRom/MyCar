"short CruiseLoopStep component description"
component SlipCruiseIcePatch
  controller = MyCar.CruiseController(y_max = 150, y_min = 0, xi0 = 31.078 / 56) {^controller}
  road = BlockComponents.Sources.Constant(k = 0) {^road}
  demand = BlockComponents.Sources.Constant(k = 90) {^demand}
  friction = BlockComponents.Sources.Pulse(amplitude = 0.05, offset = 1, start_time = 4, duty_cycle = 1, period = 8) {^friction}
  plant = MyCar.SlipCar() {^plant}
relations
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 25
  initial plant.engine.lag.x = 31.078
  # The slip tire decouples wheel speed from vehicle speed, so the wheel carries its own state.
  initial plant.wheel_inertia.phi = 0
  # 25 m/s plus the 0.00156 slip that produces the 401 N cruise tractive force: 25*1.00156/0.31.
  initial plant.wheel_inertia.w = 80.7708
  connect(demand.y, controller.u_s) {^id6}
  connect(controller.y, plant.tau_cmd) {^id7}
  connect(road.y, plant.grade) {^id8}
  connect(plant.v_kmh, controller.u_m) {^id9}
  connect(friction.y, plant.mu_scale) {^id10}
metadata {
