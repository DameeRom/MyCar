"short SlipCarStandingStart component description"
component SlipCarStandingStart
  cmd = BlockComponents.Sources.Constant(k = 150) {^cmd}
  friction = BlockComponents.Sources.Constant(k = 0.2) {^friction}
  road = BlockComponents.Sources.Constant(k = 0) {^road}
  car = MyCar.SlipCar() {^car}
relations
  connect(cmd.y, car.tau_cmd) {^id5}
  connect(road.y, car.grade) {^id6}
  connect(friction.y, car.mu_scale) {^id7}
  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.engine.lag.x = 0
  initial car.wheel_inertia.phi = 0
  initial car.wheel_inertia.w = 0
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "cmd": {
      "Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 650, "y2": 750}}}
    },
    "friction": {
