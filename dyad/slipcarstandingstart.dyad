    },
    "road": {"Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 50, "y2": 150}}}},
    "car": {
      "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 440, "y2": 540}}}
    },
